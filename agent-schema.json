{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORBIT Agent Workflow Schema",
  "type": "object",
  "required": [
    "goal",
    "planning_horizon_days",
    "available_hours_per_day",
    "workflow"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "planning_horizon_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "available_hours_per_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "tool",
          "purpose"
        ],
        "properties": {
          "step": {
            "type": "integer"
          },
          "tool": {
            "type": "string",
            "enum": [
              "create_tasks",
              "list_tasks",
              "prioritize_tasks",
              "reflect_progress",
              "write_report"
            ]
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 5
        },
        "priority": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  }
}
